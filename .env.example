# ==============================================================================
# AI TRADING COPILOT - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Sử dụng để thiết lập trong mục Environment của Render Dashboard
# ==============================================================================

# Cổng mạng (Render sẽ tự động cấp phát biến PORT, không cần chỉnh sửa)
PORT=8000
HOST=0.0.0.0

# Bật luồng quét Binance tự động chạy nền song song với Web Dashboard
ENABLE_SCANNER=true
SCAN_INTERVAL=60

# Telegram Bot (Nếu muốn nhận thông báo về điện thoại)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Cloud Gateway (Nếu muốn dùng OpenRouter DeepSeek-R1 thay vì offline Devil's Advocate)
OPENROUTER_API_KEY=

# Vốn tài khoản khả dụng ($ USD)
ACCOUNT_EQUITY=200.0
